# uConsole CM4 additions for Fedora's system-boot config.txt
# Baseline: clockworkpi/uConsole Code/patch/cm4/20230630/config.txt
ignore_lcd=1
dtoverlay=vc4-kms-v3d-pi4,cma-384
# Phase 2/3 overlays (retargeted, built in overlays/):
#dtoverlay=devterm-pmu
#dtoverlay=devterm-panel-uc
#dtoverlay=devterm-misc
# Screen power: pull GPIO9 high at firmware stage (vendor pi-gen behavior)
gpio=9=op
# Audio jack remap (audremap equivalent; verify pins on Fedora overlay set)
dtoverlay=audio-analog
